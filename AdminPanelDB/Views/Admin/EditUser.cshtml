@model AdminPanelDB.Models.Personen

<h2 style="text-align:center;">Benutzer bearbeiten</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red; text-align:center; font-weight:bold;">
        @ViewBag.Error
    </p>
}


@{
    // Aktuelle Abteilungen, Referate und Rollen des Benutzers (für Checkbox-Status)
    var aktuelleAbt = ViewBag.AktuelleAbteilungen as List<string> ?? new List<string>();
    var aktuelleRef = ViewBag.AktuelleReferate as List<string> ?? new List<string>();
    var aktuelleRollen = ViewBag.AktuelleRollen as List<string> ?? new List<string>();
}

<div class="form-container">
    <form asp-action="EditUser" method="post">
        <input type="hidden" asp-for="Id" />

        <!-- Versteckte Felder für Pagination und Sortierung. -->
        <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
        <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
        <input type="hidden" name="sortColumn" value="@ViewBag.SortColumn" />
        <input type="hidden" name="sortDirection" value="@ViewBag.SortDirection" />

        <label asp-for="Titel">Titel:</label>
        <select asp-for="Titel" asp-items="ViewBag.TitelListe" class="form-control">
            <option value="">-- Select Titel --</option>
        </select>

        <label asp-for="Name">Name:</label>
        <input asp-for="Name" />

        <label asp-for="Vorname">Vorname:</label>
        <input asp-for="Vorname" />

        <label asp-for="Email">Email:</label>
        <input asp-for="Email" id="emailInput" />

        <label asp-for="UId">UId:</label>
        <input asp-for="UId" id="uidInput" readonly />


        <!-- Abteilungen & Referate -->
        <label>Abteilungen & Referate:</label>
        <div class="selection-section">
            <div class="selection-container">
                @foreach (var abt in ViewBag.Abteilungen)
                {
                    bool isChecked = aktuelleAbt.Contains(abt.Name);
                    <div class="abteilung-block">
                        <div class="abt-header">
                            <label class="checkbox-label">
                                <input type="checkbox"
                                       name="SelectedAbteilungen"
                                       value="@abt.Name"
                                       class="abt-checkbox"
                                       data-id="@abt.Id"
                                       data-name="@abt.Name"
                                       @(isChecked ? "checked" : "") />
                                <strong>@abt.Name</strong>
                            </label>
                            <div class="referate-container"
                                 id="referate-@abt.Id"
                                 style="display:@(isChecked ? "block" : "none");"
                                 data-loaded="false">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <label asp-for="Stelle">Stelle:</label>
        <input asp-for="Stelle" />

        <label asp-for="Kennwort">Kennwort:</label>
        <input type="password" name="Kennwort" placeholder="Leer lassen = unverändert" autocomplete="new-password" />

        <!-- Rollen -->
        <label>Rollen:</label>
        <div class="selection-section">
            <div class="selection-container">
                <div class="rollen-checkboxes">
                    @foreach (var r in ViewBag.RollenListe as List<string>)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox" name="SelectedRollen" value="@r"
                                   @(aktuelleRollen.Contains(r) ? "checked" : "") />
                            @r
                        </label>
                    }
                </div>
            </div>
        </div>

        <div style ="text-align:center;">
            <a asp-controller="Admin" asp-action="TKennwort" asp-route-userId="@Model.Id" class="abtn" style="text-decoration:none;">
                Temporäres Kennwort erstellen
            </a>
        </div>

        <button type="submit">Speichern</button>
    </form>

    <a asp-action="Personen"
       asp-route-pageNumber="@ViewBag.PageNumber"
       asp-route-pageSize="@ViewBag.PageSize"
       asp-route-sortColumn="@ViewBag.SortColumn"
       asp-route-sortDirection="@ViewBag.SortDirection">
        Zurück
    </a>
</div>


<script>
    // Referate laden (für bereits gecheckte Abteilungen beim Laden)
    document.addEventListener("DOMContentLoaded", function () {
        var aktuelleReferate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aktuelleRef));

        document.querySelectorAll(".abt-checkbox").forEach(function (checkbox) {
            // Beim Laden: gecheckte Abteilungen sofort laden
            if (checkbox.checked) {
                loadReferate(checkbox, aktuelleReferate);
            }

            checkbox.addEventListener("change", function () {
                var container = document.getElementById("referate-" + this.getAttribute("data-id"));
                if (this.checked) {
                    container.style.display = "block";
                    loadReferate(this, aktuelleReferate);
                } else {
                    container.style.display = "none";
                    container.innerHTML = '';
                }
            });
        });
    });

    // Funktion zum Laden der Referate einer Abteilung. Manuel.
    function loadReferate(checkbox, aktuelleReferate) {
        var abtId = checkbox.getAttribute("data-id");
        var abtName = checkbox.getAttribute("data-name");
        var container = document.getElementById("referate-" + abtId);

        container.innerHTML = '<small style="color:gray;">Wird geladen...</small>';

        fetch('/Admin/GetReferateByAbteilung?abteilungId=' + abtId)
            .then(r => r.json())
            .then(data => {
                if (data.length === 0) {
                    container.innerHTML = '<div style="color:gray;">Keine Referate</div>';
                    return;
                }
                container.innerHTML = data.map(ref => {
                    var val = `${ref.name}:${abtName}`;
                    var isChecked = aktuelleReferate.includes(val) ? "checked" : "";
                    return `
                        <label class="checkbox-label" style="font-weight:normal; margin-left:20px;">
                            <input type="checkbox"
                                   name="SelectedReferate"
                                   value="${val}"
                                   ${isChecked} />
                            ${ref.name}
                        </label>`;
                }).join('');
            });
    }

    // Automatisches Ausfüllen der UId basierend auf der E-Mail-Adresse.
    document.getElementById("emailInput").addEventListener("input", function () {
        var email = this.value;
        var uid = "";
        if (email.indexOf("@@") !== -1) {
            uid = email.split("@@")[0];
        }
        document.getElementById("uidInput").value = uid;
    });
</script>



