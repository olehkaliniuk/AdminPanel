@model AdminPanelDB.Models.Hauptgruppe
@if (ViewBag.Error != null)
{
    <p style="color:red; text-align:center; font-weight:bold;">
        @ViewBag.Error
    </p>
}
<h2 style="text-align:center;">Hauptgruppe bearbeiten</h2>
<div class="form-container">
    <form asp-action="EditHauptgruppe" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ObjektId" />
        <input type="hidden" name="pageSize" value="@ViewBag.PageSize" />
        <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
        <div>
            <label asp-for="GehoertZuKategorie">Kategorie:</label>
            <select asp-for="GehoertZuKategorie"
                    asp-items="@(new SelectList(ViewBag.Kategorien, "KategorieNummer", "Bezeichnung", Model.GehoertZuKategorie))"
                    class="@((ViewBag.DropdownEnable != null && ViewBag.DropdownEnable == true) ? "" : "readonly-select")">
            </select>
        </div>
        <div>
            <label asp-for="Bezeichnung">Bezeichnung:</label>
            <input asp-for="Bezeichnung" maxlength="120" />
        </div>
        <div>
            <label asp-for="Kuerzel">Kuerzel:</label>
            <input asp-for="Kuerzel" maxlength="10" />
        </div>
        <div>
            <label asp-for="Beschreibung">Beschreibung:</label>
            <textarea asp-for="Beschreibung" maxlength="280"></textarea>
        </div>
        <div>
            <label asp-for="HauptgruppeNummer">HauptgruppeNummer:</label>
            <input type="number" asp-for="HauptgruppeNummer" />
        </div>
        <div>
            <label asp-for="LaufenderAktenzeichenZaehler">LaufenderAktenzeichenZaehler:</label>
            <input type="number" asp-for="LaufenderAktenzeichenZaehler" />
        </div>
        <div>
            <label asp-for="IstAktiv">IstAktiv:</label>
            <input asp-for="IstAktiv" type="checkbox" />
        </div>
        <div>
            <label asp-for="IstTestGruppe">IstTestGruppe:</label>
            <input asp-for="IstTestGruppe" type="checkbox" />
        </div>
        @if (ViewBag.DropdownEnable != null && (bool)ViewBag.DropdownEnable == true)
        {
            <div>
                <label>Auf alle Nebengruppen anwenden:</label>
                <input name="applyToGroups" type="checkbox" value="true" />
            </div>
        }

        <!-- Referate gruppiert nach Abteilung — bereits zugewiesene vorausgewählt -->
        @{

            var referateByAbteilung = ViewBag.ReferateByAbteilung as Dictionary<string, List<AdminPanelDB.Models.Referat>>;

        }

        <label>Referate:</label>
        <div class="selection-section">
            <div class="selection-container">
                @if (referateByAbteilung != null)
                {
                    foreach (var abtEntry in referateByAbteilung)
                    {
                        <div class="abteilung-group">
                            <div class="abteilung-header">
                                <strong>@abtEntry.Key</strong>
                            </div>
                            <div class="referat-list">
                                @foreach (var refa in abtEntry.Value)
                                {
                                    bool istAusgewaehlt = ((List<string>)ViewBag.BereitsZugewieseneReferate).Contains(refa.Name);
                                    <div class="referat-item">
                                        <input type="checkbox"
                                               name="selectedReferate"
                                               value="@abtEntry.Key|@refa.Name"
                                               id="ref_@refa.Id"
                                               @(istAusgewaehlt ? "checked" : "") />
                                        <label for="ref_@refa.Id">@refa.Name</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <button type="submit">Speichern</button>
    </form>
    <a asp-action="KaGruppen"
       asp-route-kategorieNummer="@Model.GehoertZuKategorie"
       asp-route-pageNumber="@ViewBag.PageNumber"
       asp-route-pageSize="@ViewBag.PageSize">
        Zurück
    </a>
</div>