@model AdminPanelDB.Models.Kategorie

@{
    var alleAbteilungen = (List<AdminPanelDB.Models.Abteilung>)ViewBag.Abteilungen;
    var selectedAbteilungen = (List<string>)ViewBag.SelectedAbteilungen;
}

@if (ViewBag.Error != null)
{
    <p style="color:red; text-align:center; font-weight:bold;">
        @ViewBag.Error
    </p>
}

<h2 style="text-align:center;">Kategorie bearbeiten</h2>


<div class="form-container">
    <form asp-action="EditKategorie" method="post">

        <div>
            <label asp-for="Bezeichnung">Bezeichnung:</label>
            <input asp-for="Bezeichnung" maxlength="120" />
        </div>

        <div>
            <label asp-for="Kuerzel">Kuerzel:</label>
            <input asp-for="Kuerzel" maxlength="10" />
        </div>

        <div>
            <label asp-for="Beschreibung">Beschreibung:</label>
            <textarea asp-for="Beschreibung" maxlength="280"></textarea>
        </div>

        <div>
            <label asp-for="KategorieNummer">KategorieNummer:</label>
            <input type="number" asp-for="KategorieNummer" />
        </div>

        <div>
            <label asp-for="IstAktiv">IstAktiv:</label>
            <input asp-for="IstAktiv" type="checkbox" />
        </div>

        <div>
            <label asp-for="IstTestKategorie">IstTestKategorie:</label>
            <input asp-for="IstTestKategorie" type="checkbox" />
        </div>


        @if (ViewBag.DropdownEnable != null && (bool)ViewBag.DropdownEnable == true)
        {
            <div>
                <label>Auf alle Gruppen anwenden:</label>
                <input name="applyToGroups" type="checkbox" value="true" />
            </div>
        }


        <!-- Abteilungen -->
        <label>Abteilungen:</label>
        <div class="selection-section">
            <div class="selection-container">
                <div class="abteilung-list">
                    @foreach (var abt in alleAbteilungen)
                    {
                        var isChecked = selectedAbteilungen != null && selectedAbteilungen.Contains(abt.Name);
                        <div class="abteilung-item">
                            <input type="checkbox"
                                   name="selectedAbteilungen"
                                   value="@abt.Name"
                                   id="abt_@abt.Id"
                                   @(isChecked ? "checked" : "") />
                            <label for="abt_@abt.Id">@abt.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <button type="submit">Speichern</button>

    </form>
    <a asp-action="KaGruppen">Züruck</a>
</div>
